# Copie este arquivo para .env e preencha com os seus valores.
# O .env NUNCA vai para o Git (está no .gitignore).

# String de conexão do MongoDB (Atlas ou local).
MONGO_URI=mongodb://127.0.0.1:27017/OpenPOS

# Qualquer string aleatória longa, usada para assinar o cookie de sessão.
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

# Porta em que a API Express vai rodar.
PORT=3000

# Origem do front-end React em desenvolvimento (Vite).
FRONTEND_ORIGIN=http://localhost:5173
